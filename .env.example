OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=openai/gpt-oss-120b

# Groq offers a free tier with an OpenAI-SDK-compatible API. If GROQ_API_KEY
# is set, the AI service calls Groq (via the OpenAI SDK pointed at Groq's
# base URL) instead of OpenAI. Leave blank to use OpenAI directly.
GROQ_API_KEY=your_groq_api_key

DATABASE_URL=sqlite:///./leads.db

N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-qualified

NOTIFICATION_EMAIL=team@example.com
