    },
    {
      "parameters": {
        "jsCode": "// The Webhook node nests the actual POST body under `.body`.\nconst item = ($input.first().json && $input.first().json.body) || {};\n\nconst requiredFields = ['lead_id', 'qualification_status', 'lead_score', 'requires_human_review'];\nconst missingFields = requiredFields.filter((f) => item[f] === undefined || item[f] === null);\n\nconst validStatuses = ['qualified', 'needs_review', 'unqualified'];\nconst statusValid = validStatuses.includes(item.qualification_status);\n\nconst scoreValid = typeof item.lead_score === 'number' && item.lead_score >= 0 && item.lead_score <= 100;\n\nconst errors = [];\nfor (const field of missingFields) {\n  errors.push(`Missing required field: ${field}`);\n}\nif (!statusValid && item.qualification_status !== undefined) {\n  errors.push(`Invalid qualification_status: ${item.qualification_status}`);\n}\nif (!scoreValid && item.lead_score !== undefined) {\n  errors.push(`Invalid lead_score: ${item.lead_score}`);\n}\n\nconst isValid = errors.length === 0;\n\nreturn [\n  {\n    json: {\n      ...item,\n      isValid,\n      validationErrors: errors,\n    },\n  },\n];\n"
      },
